# Copy to .env and fill in your values. Never commit .env.

# ---- Base44 platform connection (server-only) ----
# Your Base44 workspace's platform host (e.g. https://platform.base44.com)
BASE44_PLATFORM_HOST=""

# Your Base44 workspace ID
BASE44_WORKSPACE_ID=""

# Personal access token for the integration account (Editor or higher in the workspace).
# This is the most sensitive value — keep it server-side only.
BASE44_WORKSPACE_API_KEY=""

# The email of the integration account (used to filter listApps to only apps it created).
BASE44_ACCOUNT_EMAIL=""

# ---- App preview host ----
# The host Base44 serves your workspace's built apps from, e.g. apps.example.com
# Used to construct preview and published app URLs in the browser.
NEXT_PUBLIC_BASE44_APP_HOST=""
