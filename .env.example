# Copy to .env for local runs outside Docker. Never commit .env.

# ---- Chat model (server-only) ----
# ollama (default) talks to a local Ollama server running llama3.2:3b.
# openai talks to any OpenAI-compatible chat endpoint instead.
LLM_PROVIDER="ollama"

# Ollama server that serves the model (Docker Compose: http://ollama:11434)
OLLAMA_BASE_URL="http://127.0.0.1:11434"

# The local model used for chat and app builds
OLLAMA_MODEL="llama3.2:3b"

# Context window handed to the model; the build prompt includes the current HTML
LLM_NUM_CTX="8192"

# ---- OpenAI-compatible provider (only when LLM_PROVIDER=openai) ----
LLM_BASE_URL=""
LLM_MODEL=""
LLM_API_KEY=""

# ---- Storage ----
# Where apps, chat history and builds are kept (Docker Compose: /data volume)
DATA_DIR=""
